@page "/clientes/{Id:int}"
@inject ClienteApiClient Api
@inject IJSRuntime Js

<PageTitle>Detalhes do cliente</PageTitle>

@if (carregando)
{
    <div class="panel empty-state">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <div>Carregando cliente...</div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-danger" role="alert">@erro</div>
    <a class="btn btn-outline-secondary" href="/">Voltar</a>
}
else if (cliente is not null)
{
    <div class="page-heading">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1>@cliente.Nome</h1>
                <span class="status-badge @(cliente.Status == StatusCliente.Ativo ? "status-ativo" : "status-inativo")">
                    @cliente.Status
                </span>
            </div>
            <p>Cliente cadastrado em @cliente.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm").</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/">Voltar</a>
            <a class="btn btn-primary" href="clientes/@Id/editar">Editar</a>
            <button class="btn @(cliente.Status == StatusCliente.Ativo ? "btn-outline-danger" : "btn-outline-success")"
                    @onclick="AlterarStatus">
                @(cliente.Status == StatusCliente.Ativo ? "Inativar" : "Ativar")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert alert-success">@mensagem</div>
    }

    <section class="panel">
        <h2 class="section-title">Dados do cliente</h2>
        <div class="row g-4">
            <div class="col-12 col-md-6 col-xl-3">
                <small class="text-secondary d-block">CPF</small>
                <strong>@FormatarCpf(cliente.Cpf)</strong>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <small class="text-secondary d-block">E-mail</small>
                <strong>@cliente.Email</strong>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <small class="text-secondary d-block">Telefone</small>
                <strong>@FormatarTelefone(cliente.Telefone)</strong>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <small class="text-secondary d-block">Data de nascimento</small>
                <strong>@cliente.DataNascimento.ToString("dd/MM/yyyy")</strong>
            </div>
            <div class="col-12 col-md-6">
                <small class="text-secondary d-block">Última atualização</small>
                <strong>@FormatarAtualizacao(cliente.DataAtualizacao)</strong>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="section-title mb-0">Endereços</h2>
            <button class="btn btn-sm btn-primary" @onclick="IniciarAdicaoEndereco">
                Adicionar endereço
            </button>
        </div>

        @if (enderecoForm is not null)
        {
            <div class="border rounded-3 p-3 mb-3 bg-light">
                <h3 class="section-title">
                    @(enderecoEdicaoId.HasValue ? "Editar endereço" : "Novo endereço")
                </h3>
                <EnderecoForm Model="enderecoForm"
                              Processando="salvandoEndereco"
                              TextoBotao="@(enderecoEdicaoId.HasValue ? "Salvar alterações" : "Adicionar endereço")"
                              OnSubmit="SalvarEndereco"
                              OnCancel="CancelarEdicaoEndereco" />
            </div>
        }

        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Endereço</th>
                        <th>CEP</th>
                        <th>Cidade/UF</th>
                        <th>Tipo</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var endereco in cliente.Enderecos.OrderByDescending(item => item.Principal))
                    {
                        <tr>
                            <td>
                                @endereco.Logradouro, @endereco.Numero
                                @if (!string.IsNullOrWhiteSpace(endereco.Complemento))
                                {
                                    <small class="text-secondary d-block">@endereco.Complemento</small>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-end gap-1">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => IniciarEdicaoEndereco(endereco)">
                                        Editar
                                    </button>
                                    @if (!endereco.Principal)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => DefinirPrincipal(endereco)">
                                            Tornar principal
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(cliente.Enderecos.Count == 1)"
                                            title="@(cliente.Enderecos.Count == 1 ? "O único endereço não pode ser excluído" : "Excluir endereço")"
                                            @onclick="() => RemoverEndereco(endereco)">
                                        Excluir
                                    </button>
                                </div>
                            </td>
                            <td>@FormatarCep(endereco.Cep)</td>
                            <td>@endereco.Cidade/@endereco.Estado</td>
                            <td>
                                @if (endereco.Principal)
                                {
                                    <span class="badge text-bg-primary">Principal</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Secundário</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ClienteModel? cliente;
    private bool carregando = true;
    private string? erro;
    private string? mensagem;
    private EnderecoFormModel? enderecoForm;
    private int? enderecoEdicaoId;
    private bool salvandoEndereco;

    protected override Task OnParametersSetAsync()
    {
        return Carregar();
    }

    private async Task Carregar()
    {
        carregando = true;
        erro = null;

        try
        {
            cliente = await Api.ObterAsync(Id);
        }
        catch (ClienteApiException exception)
        {
            erro = exception.Message;
        }
        catch (HttpRequestException)
        {
            erro = "Não foi possível conectar à API.";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task AlterarStatus()
    {
        if (cliente is null)
        {
            return;
        }

        var ativar = cliente.Status == StatusCliente.Inativo;
        var acao = ativar ? "ativar" : "inativar";
        var confirmou = await Js.InvokeAsync<bool>("confirm", $"Deseja realmente {acao} este cliente?");

        if (!confirmou)
        {
            return;
        }

        try
        {
            if (ativar)
            {
                await Api.AtivarAsync(Id);
            }
            else
            {
                await Api.InativarAsync(Id);
            }

            mensagem = ativar ? "Cliente ativado com sucesso." : "Cliente inativado com sucesso.";
            await Carregar();
        }
        catch (ClienteApiException exception)
        {
            erro = exception.Message;
        }
    }

    private void IniciarAdicaoEndereco()
    {
        enderecoEdicaoId = null;
        enderecoForm = new EnderecoFormModel();
        erro = null;
    }

    private void IniciarEdicaoEndereco(EnderecoModel endereco)
    {
        enderecoEdicaoId = endereco.Id;
        enderecoForm = new EnderecoFormModel
        {
            Cep = endereco.Cep,
            Logradouro = endereco.Logradouro,
            Numero = endereco.Numero,
            Complemento = endereco.Complemento,
            Bairro = endereco.Bairro,
            Cidade = endereco.Cidade,
            Estado = endereco.Estado,
            Principal = endereco.Principal
        };
        erro = null;
    }

    private void CancelarEdicaoEndereco()
    {
        enderecoForm = null;
        enderecoEdicaoId = null;
    }

    private async Task SalvarEndereco()
    {
        if (enderecoForm is null)
        {
            return;
        }

        salvandoEndereco = true;
        erro = null;

        try
        {
            if (enderecoEdicaoId.HasValue)
            {
                await Api.AtualizarEnderecoAsync(Id, enderecoEdicaoId.Value, enderecoForm);
                mensagem = "Endereço atualizado com sucesso.";
            }
            else
            {
                await Api.AdicionarEnderecoAsync(Id, enderecoForm);
                mensagem = "Endereço adicionado com sucesso.";
            }

            CancelarEdicaoEndereco();
            await Carregar();
        }
        catch (ClienteApiException exception)
        {
            erro = exception.Message;
        }
        finally
        {
            salvandoEndereco = false;
        }
    }

    private async Task DefinirPrincipal(EnderecoModel endereco)
    {
        try
        {
            await Api.DefinirEnderecoPrincipalAsync(Id, endereco.Id);
            mensagem = "Endereço principal alterado com sucesso.";
            await Carregar();
        }
        catch (ClienteApiException exception)
        {
            erro = exception.Message;
        }
    }

    private async Task RemoverEndereco(EnderecoModel endereco)
    {
        var confirmou = await Js.InvokeAsync<bool>(
            "confirm",
            $"Deseja excluir o endereço {endereco.Logradouro}, {endereco.Numero}?");

        if (!confirmou)
        {
            return;
        }

        try
        {
            await Api.RemoverEnderecoAsync(Id, endereco.Id);
            mensagem = "Endereço excluído com sucesso.";
            await Carregar();
        }
        catch (ClienteApiException exception)
        {
            erro = exception.Message;
        }
    }

    private static string FormatarCpf(string valor)
    {
        var numeros = new string(valor.Where(char.IsDigit).ToArray());
        return numeros.Length == 11
            ? $"{numeros[..3]}.{numeros[3..6]}.{numeros[6..9]}-{numeros[9..]}"
            : valor;
    }

    private static string FormatarTelefone(string valor)
    {
        var numeros = new string(valor.Where(char.IsDigit).ToArray());
        return numeros.Length == 11
            ? $"({numeros[..2]}) {numeros[2..7]}-{numeros[7..]}"
            : valor;
    }

    private static string FormatarCep(string valor)
    {
        var numeros = new string(valor.Where(char.IsDigit).ToArray());
        return numeros.Length == 8 ? $"{numeros[..5]}-{numeros[5..]}" : valor;
    }

    private static string FormatarAtualizacao(DateTime? data)
    {
        return data.HasValue
            ? data.Value.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")
            : "Ainda não houve atualização";
    }
}
